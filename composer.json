{
    "name": "jdominguezpaz/notifier",
    "description": "Notifier plugin for CakePHP",
    "type": "cakephp-plugin",
    "require": {
        "php": ">=7.4",
        "cakephp/cakephp": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "*",
        "cakephp/cakephp-codesniffer": "2.*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/jdominguezpaz/notifier"
        }
    ],
    "autoload": {
        "psr-4": {
            "Bakkerij\\Notifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bakkerij\\Notifier\\Test\\": "tests/"
        }
    }
}
